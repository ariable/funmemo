# 数据库连接（SQLite）
DATABASE_URL="file:./dev.db"

# FunASR 语音识别 API
FUNASR_API_BASE_URL="http://127.0.0.1:17003"
FUNASR_API_TOKEN=""
FUNASR_MODEL="qwen3-asr"

# LLM 纪要生成 API（OpenAI 兼容）
LLM_API_BASE_URL=""
LLM_API_KEY=""
LLM_MODEL=""

# 文件存储目录
STORAGE_ROOT="./storage"

# 统一登录后由上游网关或鉴权层注入的用户头
AUTH_USER_ID_HEADER="x-user-id"
AUTH_USER_NAME_HEADER="x-user-name"
AUTH_USER_LOGIN_HEADER="x-user-login"

# 应用内登录会话签名密钥
AUTH_SECRET=""

# 本地会话有效期（秒）
AUTH_SESSION_MAX_AGE_SEC="604800"

# Casdoor OIDC 配置
AUTH_CASDOOR_ISSUER="http://192.168.43.249:8910"
AUTH_CASDOOR_ID=""
AUTH_CASDOOR_SECRET=""
AUTH_CASDOOR_SCOPE="openid profile email"

# 可选：自定义登录入口，默认使用 /api/auth/sign-in/casdoor
AUTH_LOGIN_URL=""

# 统一登录入口接收“登录后回跳地址”的参数名
AUTH_LOGIN_RETURN_TO_PARAM="returnTo"
